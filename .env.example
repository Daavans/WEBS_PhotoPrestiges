# Database Configuration
DATABASE_URL=postgresql://photouser:photopass@localhost:5432/photoprestiges

# Redis Configuration
REDIS_URL=redis://localhost:6379

# JWT Configuration
JWT_SECRET=change-this-to-a-secure-random-string-in-production
JWT_EXPIRY=24h
JWT_REFRESH_EXPIRY=7d

# Service Ports
AUTH_SERVICE_PORT=3001
REGISTER_SERVICE_PORT=3002
TARGET_SERVICE_PORT=3003
SCORE_SERVICE_PORT=3004
MAIL_SERVICE_PORT=3005
CLOCK_SERVICE_PORT=3006
READ_SERVICE_PORT=3007

# AWS S3 Configuration (voor Target Service)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=eu-west-1
AWS_S3_BUCKET=photoprestiges-photos
CDN_URL=https://cdn.photoprestiges.com

# Image Analysis APIs
IMAGGA_API_KEY=your_imagga_api_key
IMAGGA_API_SECRET=your_imagga_api_secret
GOOGLE_VISION_API_KEY=your_google_vision_api_key

# Email Service (SendGrid)
SENDGRID_API_KEY=your_sendgrid_api_key
EMAIL_FROM=noreply@photoprestiges.com
EMAIL_FROM_NAME=Photo Prestiges

# Alternative: SMTP Configuration
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your_smtp_user
# SMTP_PASSWORD=your_smtp_password

# Frontend URL
FRONTEND_URL=https://photoprestiges.com

# Environment
NODE_ENV=development

# Security
BCRYPT_ROUNDS=10

# Upload Limits
MAX_FILE_SIZE=10485760
ALLOWED_FORMATS=jpg,jpeg,png,webp

# Gamification
POINTS_PER_UPLOAD=10
POINTS_PER_VOTE_RECEIVED=1
POINTS_PER_VOTE_GIVEN=0.5

# Timezone
TZ=Europe/Amsterdam
