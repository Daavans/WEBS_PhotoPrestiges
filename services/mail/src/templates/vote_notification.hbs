<!DOCTYPE html>
<html>
<head><meta charset="utf-8"><title>Nieuwe stem op je foto</title></head>
<body style="font-family: sans-serif; max-width: 600px; margin: 0 auto; padding: 20px; color: #2d3748;">
  <h1 style="color: #4f46e5;">Hallo {{username}},</h1>
  <p>Je foto <strong>{{photoTitle}}</strong> heeft een nieuwe stem ontvangen!</p>
  <p style="font-size:18px;">Totaal stemmen: <strong style="color:#4f46e5;">{{totalVotes}}</strong></p>
  <a href="{{photoUrl}}"
     style="display:inline-block;padding:12px 24px;background:#4f46e5;color:#fff;text-decoration:none;border-radius:6px;margin:16px 0;">
    Bekijk je foto
  </a>
  <hr style="margin-top:40px;border:none;border-top:1px solid #e2e8f0;">
  <p style="font-size:12px;color:#a0aec0;">
    Photo Prestiges &mdash; <a href="{{unsubscribeUrl}}" style="color:#a0aec0;">Uitschrijven van stem notificaties</a>
  </p>
</body>
</html>
