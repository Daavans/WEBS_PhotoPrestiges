<!DOCTYPE html>
<html>
<head><meta charset="utf-8"><title>Wekelijkse samenvatting</title></head>
<body style="font-family: sans-serif; max-width: 600px; margin: 0 auto; padding: 20px; color: #2d3748;">
  <h1 style="color: #4f46e5;">Hallo {{username}},</h1>
  <p>Hier is jouw wekelijkse samenvatting van Photo Prestiges:</p>
  <table style="width:100%;border-collapse:collapse;margin:16px 0;">
    <tr style="background:#f7fafc;">
      <td style="padding:12px;border:1px solid #e2e8f0;">Stemmen ontvangen</td>
      <td style="padding:12px;border:1px solid #e2e8f0;font-weight:bold;color:#4f46e5;">{{totalVotes}}</td>
    </tr>
    <tr>
      <td style="padding:12px;border:1px solid #e2e8f0;">Nieuwe badges</td>
      <td style="padding:12px;border:1px solid #e2e8f0;font-weight:bold;color:#4f46e5;">{{newBadges}}</td>
    </tr>
    <tr style="background:#f7fafc;">
      <td style="padding:12px;border:1px solid #e2e8f0;">Jouw rang</td>
      <td style="padding:12px;border:1px solid #e2e8f0;font-weight:bold;color:#4f46e5;">#{{rank}}</td>
    </tr>
  </table>
  <a href="{{frontendUrl}}"
     style="display:inline-block;padding:12px 24px;background:#4f46e5;color:#fff;text-decoration:none;border-radius:6px;margin:16px 0;">
    Bekijk je profiel
  </a>
  <hr style="margin-top:40px;border:none;border-top:1px solid #e2e8f0;">
  <p style="font-size:12px;color:#a0aec0;">
    Photo Prestiges &mdash; <a href="{{unsubscribeUrl}}" style="color:#a0aec0;">Uitschrijven van wekelijkse samenvatting</a>
  </p>
</body>
</html>
