MONGODB_URI=mongodb://localhost:27017/photoprestiges

# Monitoring: gebruik prometheus.local.yml voor lokale ontwikkeling (services draaien op host)
# Gebruik prometheus.yml voor volledige Docker deployment (services in Docker netwerk)
PROMETHEUS_CONFIG=./monitoring/prometheus.yml

# Service-to-service authenticatie (verplicht voor mail endpoint beveiliging)
SERVICE_SECRET=photoprestiges-internal-secret
JWT_SECRET=your_jwt_secret
AUTH_SERVICE_PORT=3001
FRONTEND_URL=http://localhost:3000

IMAGGA_API_KEY=
IMAGGA_API_SECRET=

# Mail Service
MAIL_SERVICE_PORT=3005
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev
EMAIL_FROM_NAME=Photo Prestiges

# Queue instellingen (optioneel)
QUEUE_INTERVAL_MS=5000
QUEUE_BATCH_SIZE=10
MAX_RETRY_ATTEMPTS=3

# Unsubscribe URL
UNSUBSCRIBE_URL=http://localhost:3000/unsubscribe

# Clock Service
CLOCK_SERVICE_PORT=3006

# Read Service
READ_SERVICE_PORT=3007

# Newman test runner
POSTMAN_API_KEY=
# vul in: JWT token van admin (via POST /api/auth/login)
ADMIN_TOKEN=
USER_TOKEN=